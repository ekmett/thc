      ForeignExports,ForeignExportProvenance,ForeignImportProvenance,JSON,Sources,
      Wired}.hs; compact-core; GHC/ghc-boot 9.14.1; Cabal-declared libraries.
    OUT THC plugin shared library and its registration/interfaces.
  lib:compact-core:
    IN src/cbd/THC/Compact/{Wire,Writer,Core,Facts,Module,JSON,Inspect,Encode,Decode,
      Debug,Annotations,Compression,Zip}.hs; core-symbols; declared codec/zip libs.
    OUT compact-core library/interfaces consumed by tools and fixture executable.
  lib:core-symbols:
