cabal-version: 3.0
name: tiny-fixture
version: 0.1.0.0
build-type: Simple
license: UPL-1.0 AND BSD-3-Clause

flag loud
  description: Select the uppercase greeting
  default: False
  manual: True

flag unavailable
  description: Exercise Cabal's automatic flag fallback
  default: True
  manual: False

common defaults
  default-language: Haskell2010
  build-depends: base >= 4.22 && < 4.23

library words
  import: defaults
  hs-source-dirs: words
  exposed-modules: Words

library
  import: defaults
  hs-source-dirs: src
  exposed-modules: Greeting
  build-depends: tiny-fixture:words
  if flag(loud)
    hs-source-dirs: loud
    other-modules: Message
  else
    hs-source-dirs: quiet
    other-modules: Message
  if flag(unavailable)
    build-depends: thc-deliberately-unavailable == 9999
  if os(linux)
    other-modules: Platform.Linux
  else
    other-modules: Platform.Other
  if impl(ghc >= 9.14)
    cpp-options: -DRECENT_GHC

executable hello
  import: defaults
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: tiny-fixture

test-suite greeting-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: tiny-fixture

benchmark greeting-bench
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: tiny-fixture
