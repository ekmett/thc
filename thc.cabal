build-type: Simple

-- Small, docs-only assembly/link checker. No GHC API or runtime dependency.
executable thc-docs
  main-is: Main.hs
  hs-source-dirs: tools/docs
  build-depends:
    base >= 4.22 && < 4.23,
    containers >= 0.8 && < 0.9,
    directory >= 1.3.10 && < 1.4,
    filepath >= 1.5.4 && < 1.6,
    process >= 1.6.26 && < 1.7,
    tagsoup >= 0.14.8 && < 0.15,
    text >= 2.1 && < 2.2
  default-language: Haskell2010
  ghc-options: -Wall

flag development
  description: Treat compiler warnings as errors
  default: False
  manual: True

flag full-core-tests
  description: Enable tests requiring a configured full-Core GHC installation
  default: False
  manual: True

-- Public application API; no GHC API or JVM dependency for native callers.
library runtime
  visibility: public
  hs-source-dirs: runtime
  exposed-modules:
    THC
    THC.Runtime
    THC.Thread
    THC.Memory
    THC.GC
    THC.Trace
    THC.Internal.JIT
  other-modules: THC.Runtime.Types, THC.Internal.RuntimeABI
  c-sources: runtime/cpu-affinity.c, runtime/runtime-services.c
  x-thc-runtime-shim: v1
  build-depends: base >= 4.22 && < 4.23
  default-language: Haskell2010
  ghc-options: -Wall
  if flag(development)
    ghc-options: -Werror

test-suite cpu-affinity-api
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test/haskell-affinity
  build-depends: base >= 4.22 && < 4.23, thc:runtime
  default-language: Haskell2010
  ghc-options: -Wall -threaded
  if flag(development)
    ghc-options: -Werror

test-suite runtime-services-api
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test/haskell-runtime
  build-depends: base >= 4.22 && < 4.23, thc:runtime
  default-language: Haskell2010
  ghc-options: -Wall -threaded
  if flag(development)
    ghc-options: -Werror

library
  hs-source-dirs: compiler
  exposed-modules: THC.Plugin, THC.Interface
  other-modules:
    THC.CBV
    THC.Demands
    THC.ForeignExports
    THC.ForeignExportProvenance
    THC.ForeignImportProvenance
    THC.Sources
    THC.Wired
  build-depends:
    base >= 4.22 && < 4.23,
    bytestring >= 0.12.2 && < 0.13,
    containers >= 0.8 && < 0.9,
    directory >= 1.3.10 && < 1.4,
    filepath >= 1.5.4 && < 1.6,
    ghc == 9.14.1,
    ghc-boot == 9.14.1
  default-language: Haskell2010
  if flag(development)
    ghc-options: -Werror

-- Selected-compiler subprocess boundary; the generic driver does not link ghc.
executable thc-interface
  main-is: Main.hs
  hs-source-dirs: compiler/interface
  build-depends:
    base >= 4.22 && < 4.23,
    thc,
    ghc == 9.14.1,
    aeson >= 2.3 && < 2.4,
    bytestring >= 0.12.2 && < 0.13,
    containers >= 0.8 && < 0.9,
    deepseq >= 1.5 && < 1.6
  default-language: Haskell2010
  ghc-options: -Wall
  if flag(development)
    ghc-options: -Werror

executable thc
  main-is: Main.hs
  hs-source-dirs: app, src
  other-modules:
    THC.Driver.Cabal
    THC.Driver.Cache
    THC.Driver.ForeignBitcode
    THC.Driver.NativeCache
    THC.Driver.NativeRecipe
    THC.Driver.PackageNative
    THC.Driver.ScalarBitcode
    THC.Driver.RuntimeShim
    THC.Driver.GhcProxy
    THC.Driver.Installed
    THC.Driver.InstalledForeign
    THC.Driver.Lock
    THC.Driver.Json
    THC.Driver.Project
    THC.Driver.Run
    THC.Driver.Zip
    THC.Driver.Wired
  build-depends:
    base >= 4.22 && < 4.23,
    Cabal == 3.16.*, Cabal-syntax == 3.16.*,
    aeson >= 2.3 && < 2.4,
    bytestring >= 0.12.2 && < 0.13,
    containers >= 0.8 && < 0.9,
    cryptohash-sha256 >= 0.11 && < 0.12,
    directory >= 1.3.10 && < 1.4,
    filepath >= 1.5.4 && < 1.6,
    process >= 1.6.26 && < 1.7,
    text >= 2.1 && < 2.2,
    zip-archive >= 0.4.3.2 && < 0.5
  if !os(windows)
    build-depends: unix >= 2.8 && < 2.9
  default-language: Haskell2010
  ghc-options: -Wall
  if flag(development)
    ghc-options: -Werror

