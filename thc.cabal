-- Small fixture bookkeeping controls; no compiler acquisition or JVM launch.
test-suite ghc-api-fixture-policy
  type: exitcode-stdio-1.0
  main-is: GhcApiAuditTests.hs
  hs-source-dirs: test/haskell-fixtures
  other-modules: GhcApiAudit
  build-depends:
    base >= 4.22 && < 4.23,
