  build-depends: base >= 4.22 && < 4.23
  default-language: Haskell2010
  ghc-options: -Wall
  if flag(development)
    ghc-options: -Werror

-- Public application API; no GHC API or JVM dependency for native callers.
library runtime
  visibility: public
  hs-source-dirs: src/runtime
  exposed-modules:
    THC
    THC.Runtime
    THC.Thread
    THC.Memory
    THC.GC
    THC.Trace
    THC.Internal.JIT
