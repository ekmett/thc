{
  "schema": 1,
  "fixtureFreeJunit": [
    "thc.runtime.HandoffTest",
    "thc.runtime.HostEntryCompilationTest",
    "thc.runtime.SimdFamiliesTest",
    "thc.runtime.TypedInputScalarSourceTest"
  ],
  "groups": {
    "runtime-core-native": {
      "junit": [
        "thc.FastSmokeTest",
        "thc.RuntimeTest",
        "thc.BytecodeBackendTest",
        "thc.SelfTailProfileTest"
      ],
      "commands": [
        {"argv": ["compiler/export.sh", "examples/THC/Fixtures.hs"]},
        {"argv": ["scripts/native-oracle.sh"], "stdout": "build/native/oracle.tsv"}
      ],
      "outputs": [
        "build/core/THC.Prim.json",
        "build/core/THC.Fixtures.json",
        "build/native/oracle.tsv"
      ],
      "sources": [
        "examples/THC/Prim.hs",
        "examples/THC/Fixtures.hs",
        "examples/NativeOracle.hs",
        "examples/THC/MapWorkload.hs",
        "scripts/native-oracle.sh"
      ]
    },
    "explicit64-primops": {
      "junit": ["thc.runtime.Explicit64PrimopsTest"],
      "commands": [
        {"argv": ["python3", "scripts/prepare-explicit64-primops.py"]}
      ],
      "outputs": ["build/explicit64-primops"],
      "sources": [
        "scripts/prepare-explicit64-primops.py",
        "compiler/test-fixtures/Explicit64PrimopsAudit.hs"
      ]
    },
    "tuple-input": {
      "junit": ["thc.runtime.TupleInputNativeTest"],
      "commands": [
        {"argv": ["python3", "scripts/prepare-tuple-input-audit.py"]}
      ],
      "outputs": ["build/tuple-input"],
      "sources": [
        "scripts/prepare-tuple-input-audit.py",
        "compiler/test-fixtures/TupleInputAudit.hs",
        "compiler/test-fixtures/TupleInputAuditNative.hs"
      ]
    },
    "integer-primops": {
      "junit": ["thc.IntegerPrimopsTest"],
      "commands": [
        {"argv": ["python3", "scripts/prepare-integer-primops.py"]}
      ],
      "outputs": ["build/integer-primops"],
      "sources": [
        "scripts/prepare-integer-primops.py",
        "compiler/test-fixtures/IntegerPrimopsAudit.hs"
      ]
    },
    "signed-narrow-primops": {
      "junit": ["thc.SignedNarrowPrimopsTest"],
      "commands": [
        {"argv": ["python3", "scripts/prepare-signed-narrow-primops.py"]}
      ],
      "outputs": ["build/signed-narrow-primops"],
      "sources": [
        "scripts/prepare-signed-narrow-primops.py",
        "compiler/test-fixtures/SignedNarrowPrimopsAudit.hs"
      ]
    },
    "bit-primops": {
      "junit": ["thc.runtime.BitPrimopsTest"],
      "commands": [
        {"argv": ["python3", "scripts/prepare-bit-primops.py"]}
      ],
      "outputs": ["build/bit-primops"],
      "sources": [
        "scripts/prepare-bit-primops.py",
        "compiler/test-fixtures/BitPrimopsAudit.hs"
      ]
    },
    "cbv-coercion": {
      "junit": [
        "thc.RealCoreEntryContractTest",
        "thc.runtime.ScalarLexicalProofTest",
        "thc.runtime.BoxedLexicalProofTest",
        "thc.runtime.ScalarPrimitiveSignatureTest"
      ],
      "commands": [
        {"argv": ["env", "THC_CORE_OUT=build/tuple-arithmetic/pre-core", "THC_GHC_OUT=build/tuple-arithmetic/pre-ghc", "compiler/export.sh", "compiler/test-fixtures/TupleArithmeticAudit.hs"]},
        {"argv": ["env", "THC_CORE_OUT=build/explicit64-primops/core", "THC_GHC_OUT=build/explicit64-primops/ghc", "compiler/export.sh", "compiler/test-fixtures/Explicit64PrimopsAudit.hs"]},
        {"argv": ["compiler/export.sh", "compiler/test-fixtures/CBVAudit.hs", "compiler/test-fixtures/CBVJoinAudit.hs", "compiler/test-fixtures/CBVCoercionAudit.hs", "compiler/test-fixtures/DemandAudit.hs"]},
        {"argv": ["python3", "scripts/check-demand-metadata.py", "--ghc-api"]},
        {"argv": ["env", "THC_CORE_OUT=build/cbv-post-core", "THC_GHC_OUT=build/cbv-post-ghc", "compiler/export.sh", "-fplugin-opt=THC.Plugin:post-tidy", "compiler/test-fixtures/CBVAudit.hs", "compiler/test-fixtures/CBVJoinAudit.hs", "compiler/test-fixtures/CBVCoercionAudit.hs"]},
        {"argv": ["python3", "scripts/check-cbv-metadata.py"]}
      ],
      "outputs": [
        "build/tuple-arithmetic/pre-core/TupleArithmeticAudit.json",
        "build/explicit64-primops/core/Explicit64PrimopsAudit.json",
        "build/core/CBVAudit.json",
        "build/core/CBVJoinAudit.json",
        "build/core/CBVCoercionAudit.json",
        "build/core/DemandAudit.json",
        "build/cbv-post-core/CBVAudit.json",
        "build/cbv-post-core/CBVJoinAudit.json",
        "build/cbv-post-core/CBVCoercionAudit.json"
      ],
      "sources": [
        "compiler/test-fixtures/TupleArithmeticAudit.hs",
        "compiler/test-fixtures/Explicit64PrimopsAudit.hs",
        "compiler/test-fixtures/CBVAudit.hs",
        "compiler/test-fixtures/CBVJoinAudit.hs",
        "compiler/test-fixtures/CBVCoercionAudit.hs",
        "compiler/test-fixtures/DemandAudit.hs",
        "scripts/check-demand-metadata.py",
        "scripts/check-cbv-metadata.py"
      ]
    },
    "data-to-tag": {
      "junit": ["thc.runtime.DataToTagTest"],
      "commands": [{"argv": ["python3", "scripts/prepare-data-to-tag.py"]}],
      "outputs": ["build/data-to-tag"],
      "sources": ["scripts/prepare-data-to-tag.py", "compiler/test-fixtures/DataToTagAudit.hs"]
    },
    "mutable-bytearray-size": {
      "junit": ["thc.runtime.MutableByteArraySizeTest"],
      "commands": [{"argv": ["python3", "scripts/prepare-mutable-bytearray-size.py"]}],
      "outputs": ["build/mutable-bytearray-size"],
      "sources": ["scripts/prepare-mutable-bytearray-size.py", "scripts/mutable_bytearray_size_model.py", "compiler/test-fixtures/MutableByteArraySizeAudit.hs"]
    },
    "int8-arrays": {
      "junit": ["thc.runtime.Int8ArrayNativeTest"],
      "commands": [{"argv": ["python3", "scripts/prepare-int8-arrays.py"]}],
      "outputs": ["build/int8-arrays"],
      "sources": ["scripts/prepare-int8-arrays.py", "scripts/prepare-int16-arrays.py", "scripts/test-int8-array-model.py", "compiler/test-fixtures/Int8ArrayAudit.hs", "examples/THC/Unboxed8Arrays.hs"]
    },
    "int16-arrays": {
      "junit": ["thc.runtime.Int16ArrayNativeTest"],
      "commands": [{"argv": ["python3", "scripts/prepare-int16-arrays.py"]}],
      "outputs": ["build/int16-arrays"],
      "sources": ["scripts/prepare-int16-arrays.py", "scripts/test-int16-array-model.py", "compiler/test-fixtures/Int16ArrayAudit.hs", "examples/THC/Unboxed16Arrays.hs"]
    },
    "int32-arrays": {
      "junit": ["thc.runtime.Int32ArrayNativeTest"],
      "commands": [{"argv": ["python3", "scripts/prepare-int32-arrays.py"]}],
      "outputs": ["build/int32-arrays"],
      "sources": ["scripts/prepare-int32-arrays.py", "scripts/test-int32-array-model.py", "compiler/test-fixtures/Int32ArrayAudit.hs", "examples/THC/Unboxed32Arrays.hs"]
    }
  }
}
