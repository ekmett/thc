+
+static void jam_remembered(void* raw, uint32_t holder, uint64_t slot_offset,
+                           int compressed, uint64_t base_slot) {
+  JamScanState* state = static_cast<JamScanState*>(raw);
+  address slot = CompressedOops::base() + slot_offset * sizeof(narrowOop);
+  guarantee(base_slot == 0, "HotSpot stack chunks relativize derived references before publication");
+  oop target;
+  if (compressed) {
+    state->old_slots.append((narrowOop*)slot);
+    target = RawAccess<>::oop_load((narrowOop*)slot);
+  } else {
+    state->wide_slots.append((oop*)slot);
+    target = RawAccess<>::oop_load((oop*)slot);
+  }
+  if (target == nullptr) return;
+  if (holder != 0) {
+    oop owner = CompressedOops::decode_not_null(CompressedOops::narrow_oop_cast(holder));
+    if (owner->klass()->is_instance_klass()) {
+      ReferenceType type = InstanceKlass::cast(owner->klass())->reference_type();
+      if (type != REF_NONE && slot == cast_from_oop<address>(owner) + java_lang_ref_Reference::referent_offset() &&
+          state->heap->ref_processor()->discover_reference(owner, type)) return;
+    }
+  }
+  uint32_t at = CompressedOops::narrow_oop_value(target);
+  state->heap->trace_external(&at, 1);
+}
+
+void JamHeap::trace_remembered_slots() {
+  jam_vm_remembered(_jam, jam_remembered, _jam_scan_state);
+}
