+++ b/src/hotspot/share/gc/jam/jamWeak.cpp
@@ -0,0 +1,172 @@
+// SPDX-FileCopyrightText: 2026 Edward Kmett
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include "classfile/vmSymbols.hpp"
+#include "gc/jam/jamHeap.hpp"
+#include "jvm.h"
+#include "oops/access.inline.hpp"
+#include "oops/compressedOops.inline.hpp"
+#include "oops/typeArrayOop.inline.hpp"
+#include "runtime/handles.inline.hpp"
+#include "runtime/interfaceSupport.inline.hpp"
+#include "runtime/jniHandles.inline.hpp"
+#include "runtime/mutexLocker.hpp"
+
+static JamHeap* jam_weak_heap(TRAPS) {
+  if (!UseJamGC) {
+    THROW_MSG_NULL(vmSymbols::java_lang_UnsupportedOperationException(),
+                   "Generalized weak associations require the Jam collector");
+  }
+  return JamHeap::heap();
+}
+
+static uint32_t jam_weak_offset(jobject value) {
+  return CompressedOops::narrow_oop_value(JNIHandles::resolve(value));
+}
+
+static oop jam_weak_object(uint32_t value) {
+  return CompressedOops::decode(CompressedOops::narrow_oop_cast(value));
+}
+
+JVM_ENTRY(jlong, JVM_JamWeakCreate(JNIEnv* env, jclass ignored,
+                                 jobject key, jobject value, jobject finalizer))
+  JamHeap* heap = jam_weak_heap(CHECK_0);
+  if (key == nullptr) {
+    THROW_MSG_0(vmSymbols::java_lang_NullPointerException(), "weak key");
+  }
+  uint64_t token;
+  {
+    MutexLocker lock(Heap_lock);
+    // Acquiring the lock may safepoint; resolve all arguments only afterward.
+    token = jam_vm_weak_create(heap->jam(), jam_weak_offset(key),
+                               jam_weak_offset(value), jam_weak_offset(finalizer));
+  }
+  if (token == 0) {
+    THROW_MSG_0(vmSymbols::java_lang_OutOfMemoryError(), "Jam weak registration metadata exhausted");
+  }
+  return jlong(token);
+JVM_END
+
+JVM_ENTRY(jobject, JVM_JamWeakDeref(JNIEnv* env, jclass ignored, jlong token))
+  JamHeap* heap = jam_weak_heap(CHECK_NULL);
+  Handle result;
+  {
+    MutexLocker lock(Heap_lock);
+    result = Handle(THREAD, jam_weak_object(jam_vm_weak_value(heap->jam(), uint64_t(token))));
+  }
+  return JNIHandles::make_local(THREAD, result());
+JVM_END
+
+JVM_ENTRY(jobject, JVM_JamWeakTake(JNIEnv* env, jclass ignored, jlongArray token_out))
+  JamHeap* heap = jam_weak_heap(CHECK_NULL);
+  if (token_out == nullptr) {
+    THROW_MSG_NULL(vmSymbols::java_lang_NullPointerException(), "finalizer token output");
+  }
+  typeArrayHandle output(THREAD, typeArrayOop(JNIHandles::resolve(token_out)));
+  if (output->length() == 0) {
+    THROW_MSG_NULL(vmSymbols::java_lang_IllegalArgumentException(), "token output needs one element");
+  }
+  Handle result;
+  {
+    MutexLocker lock(Heap_lock);
+    uint64_t token;
+    uint32_t at = jam_vm_weak_take(heap->jam(), &token);
+    output->long_at_put(0, jlong(token));
+    result = Handle(THREAD, jam_weak_object(at));
+  }
+  return JNIHandles::make_local(THREAD, result());
+JVM_END
+
+JVM_ENTRY(jobject, JVM_JamWeakFinalize(JNIEnv* env, jclass ignored, jlong token))
+  JamHeap* heap = jam_weak_heap(CHECK_NULL);
+  Handle result;
+  {
+    MutexLocker lock(Heap_lock);
+    result = Handle(THREAD, jam_weak_object(jam_vm_weak_finalize(heap->jam(), uint64_t(token))));
+  }
+  return JNIHandles::make_local(THREAD, result());
+JVM_END
+
+JVM_ENTRY(void, JVM_JamWeakComplete(JNIEnv* env, jclass ignored, jlong token))
+  JamHeap* heap = jam_weak_heap(CHECK);
+  MutexLocker lock(Heap_lock);
+  jam_vm_weak_complete(heap->jam(), uint64_t(token));
+JVM_END
+
+JVM_ENTRY(jlong, JVM_JamCandidateArm(JNIEnv* env, jclass ignored,
+                                   jobject owner, jlong wait_generation))
+  JamHeap* heap = jam_weak_heap(CHECK_0);
+  if (owner == nullptr) {
+    THROW_MSG_0(vmSymbols::java_lang_NullPointerException(), "candidate owner");
+  }
+  if (wait_generation <= 0) {
+    THROW_MSG_0(vmSymbols::java_lang_IllegalArgumentException(), "candidate wait generation must be positive");
+  }
+  uint64_t ticket;
+  {
+    MutexLocker lock(Heap_lock);
+    ticket = jam_vm_candidate_arm(heap->jam(), jam_weak_offset(owner), uint64_t(wait_generation));
+  }
+  if (ticket == 0) {
+    THROW_MSG_0(vmSymbols::java_lang_OutOfMemoryError(), "Jam candidate registration metadata exhausted");
+  }
+  return jlong(ticket);
+JVM_END
+
+static jobject jam_candidate_claim(jclass klass, jlong ticket, jlong wait_generation,
+                                   bool disarm, TRAPS) {
+  JamHeap* heap = jam_weak_heap(CHECK_NULL);
+  if (ticket <= 0 || wait_generation <= 0) return nullptr;
+  // Reserve the return handle before changing ownership; the class is a temporary root.
+  jobject result = JNIHandles::make_local(THREAD, JNIHandles::resolve_non_null(klass),
+                                          AllocFailStrategy::RETURN_NULL);
+  if (result == nullptr) {
+    THROW_MSG_NULL(vmSymbols::java_lang_OutOfMemoryError(), "Jam candidate return handle exhausted");
+  }
+  MutexLocker lock(Heap_lock);
+  uint32_t at = disarm
+    ? jam_vm_candidate_disarm(heap->jam(), uint64_t(ticket), uint64_t(wait_generation))
+    : jam_vm_candidate_poll(heap->jam(), uint64_t(ticket), uint64_t(wait_generation));
+  if (at == 0) {
+    JNIHandles::destroy_local(result);
+    return nullptr;
+  }
+  // Local JNI handles are untagged; this store cannot allocate or safepoint.
+  NativeAccess<>::oop_store(reinterpret_cast<oop*>(result), jam_weak_object(at));
+  return result;
+}
+
+JVM_ENTRY(jobject, JVM_JamCandidatePoll(JNIEnv* env, jclass klass, jlong ticket, jlong wait_generation))
+  return jam_candidate_claim(klass, ticket, wait_generation, false, THREAD);
+JVM_END
+
+JVM_ENTRY(jobject, JVM_JamCandidateDisarm(JNIEnv* env, jclass klass, jlong ticket, jlong wait_generation))
+  return jam_candidate_claim(klass, ticket, wait_generation, true, THREAD);
+JVM_END
+
+JVM_ENTRY(void, JVM_JamCandidateComplete(JNIEnv* env, jclass ignored, jlong ticket, jlong wait_generation))
+  JamHeap* heap = jam_weak_heap(CHECK);
+  if (ticket <= 0 || wait_generation <= 0) return;
+  MutexLocker lock(Heap_lock);
+  jam_vm_candidate_complete(heap->jam(), uint64_t(ticket), uint64_t(wait_generation));
+JVM_END
+
+JVM_ENTRY(jlong, JVM_JamCandidateEpoch(JNIEnv* env, jclass ignored))
+  JamHeap* heap = jam_weak_heap(CHECK_0);
+  return jlong(jam_vm_candidate_epoch(heap->jam()));
+JVM_END
+
+JVM_ENTRY(void, JVM_JamCollect(JNIEnv* env, jclass ignored, jboolean minor, jboolean promote))
+  JamHeap* heap = jam_weak_heap(CHECK);
+  // VM_GC_Operation acquires Heap_lock itself, and honors JNI critical regions.
+  heap->collect_generation(minor, promote, GCCause::_java_lang_system_gc);
+JVM_END
+
+JVM_ENTRY(jlong, JVM_JamCollections(JNIEnv* env, jclass ignored, jint kind))
+  JamHeap* heap = jam_weak_heap(CHECK_0);
+  if (kind < 0 || kind > 2) {
+    THROW_MSG_0(vmSymbols::java_lang_IllegalArgumentException(), "collection kind must be 0, 1 or 2");
+  }
+  MutexLocker lock(Heap_lock);
+  return jlong(heap->collections(kind));
+JVM_END
