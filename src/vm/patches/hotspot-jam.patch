+          make_barrier_set_c2<JamBarrierSetC2>(),
+          BarrierSet::FakeRtti(BarrierSet::JamBarrierSet)) {}
+
+void JamBarrierSet::record(oop owner, void* slot, size_t count, bool compressed) {
+  JamHeap* heap = JamHeap::heap();
+  // Check the source, never the concurrently mutable value stored in the slot.
+  if (!heap->is_in_reserved(slot) || heap->is_in_young(slot)) return;
+  uintptr_t base = (uintptr_t)CompressedOops::base();
+  jam_vm_remember(heap->jam(), owner == nullptr ? 0 : CompressedOops::narrow_oop_value(owner),
+                  ((uintptr_t)slot - base) / 4, count, compressed ? 1 : 2, compressed);
+}
+
+void JamBarrierSet::forget(address start, address end) {
+  JamHeap* heap = JamHeap::heap();
+  if (start == end || !heap->is_in_reserved(start) || heap->is_in_young(start)) return;
+  assert(end >= start && is_aligned(start, 4) && is_aligned(end, 4), "retired slot range");
+  jam_vm_forget(heap->jam(), ((uintptr_t)start - (uintptr_t)CompressedOops::base()) / 4,
+                (end - start) / 4);
+}
+
+void JamBarrierSet::record_narrow(oopDesc* owner, void* slot, size_t count) {
+  record(cast_to_oop(owner), slot, count, true);
+}
+
+void JamBarrierSet::record_array(void* slot, size_t count) {
+  record(nullptr, slot, count, UseCompressedOops);
+}
+
+class JamRememberFields : public BasicOopIterateClosure {
+  oop _owner;
+public:
+  explicit JamRememberFields(oop owner) : _owner(owner) {}
+  void do_oop(narrowOop* slot) override { JamBarrierSet::record(_owner, slot, 1, true); }
+  void do_oop(oop* slot) override { JamBarrierSet::record(_owner, slot, 1, false); }
+  ReferenceIterationMode reference_iteration_mode() override { return DO_FIELDS; }
+};
+
+void JamBarrierSet::write_region(MemRegion mr) {
+  if (mr.is_empty() || JamHeap::heap()->is_in_young(mr.start())) return;
+  // The clone hook supplies one fully formatted object, not an allocation run.
+  oop owner = cast_to_oop(mr.start());
+  JamRememberFields fields(owner);
+  owner->oop_iterate(&fields);
+}
+
+void JamBarrierSet::on_thread_create(Thread *thread) {
+  JamThreadLocalData::create(thread, JamHeap::heap()->jam());
+  // The initial thread is created before the heap; set_barrier_set calls us
+  // later on that same thread. Other Thread objects are created by a parent.
+  if (thread == Thread::current_or_null()) {
+    on_thread_start(thread);
+  }
+}
+
+void JamBarrierSet::on_thread_destroy(Thread *thread) {
+  // Initialization may fail before attach/detach. Normal SMR destruction can
+  // run on a different thread and therefore must only free an inactive context.
+  if (JamThreadLocalData::context_active(thread)) {
+    JamThreadLocalData::leave(thread);
+  }
+  JamThreadLocalData::destroy(thread);
+}
+
+void JamBarrierSet::on_thread_start(Thread* thread) {
+  JamThreadLocalData::enter(thread);
+  assert(jam_vm_thread_current(JamHeap::heap()->jam()), "Jam heap must be bound on the executing OS thread");
+}
+
+void JamBarrierSet::on_thread_attach(Thread* thread) {
+  ModRefBarrierSet::on_thread_attach(thread);
+  // Threads::add for a Java-created thread executes on its creator. JNI
+  // attachment and NonJavaThread startup execute on the attached thread.
+  if (thread == Thread::current_or_null()) {
+    on_thread_start(thread);
+  }
+}
+
+void JamBarrierSet::on_thread_detach(Thread* thread) {
+  ModRefBarrierSet::on_thread_detach(thread);
+  JamThreadLocalData::leave(thread);
+}
+
+void JamBarrierSet::print_on(outputStream* st) const { st->print("Jam exact source slots"); }
+
+JRT_LEAF(void, JamBarrierSet::clone(oopDesc* src, oopDesc* dst, size_t words))
+  HeapAccess<>::clone(src, dst, words);
+JRT_END
