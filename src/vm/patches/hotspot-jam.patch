+#ifndef SHARE_GC_JAM_JAMTHREADLOCALDATA_HPP
+#define SHARE_GC_JAM_JAMTHREADLOCALDATA_HPP
+
+#include "gc/shared/gc_globals.hpp"
+#include "runtime/javaThread.hpp"
+#include "utilities/debug.hpp"
+#include "jam_vm.h"
+
+class JamThreadLocalData {
+private:
+  size_t _ergo_tlab_size;
+  int64_t _last_tlab_time;
+  jam_vm_thread* _context;
+  bool _context_active;
+
+  explicit JamThreadLocalData(jam_vm* heap) :
+          _ergo_tlab_size(0),
+          _last_tlab_time(0),
+          _context(jam_vm_thread_create(heap)),
+          _context_active(false) {
+    guarantee(_context != nullptr, "Unable to allocate Jam thread context");
+  }
+
+  static JamThreadLocalData* data(Thread* thread) {
+    assert(UseJamGC, "Sanity");
+    return thread->gc_data<JamThreadLocalData>();
+  }
+
+public:
+  static void create(Thread* thread, jam_vm* heap) {
+    new (data(thread)) JamThreadLocalData(heap);
+  }
+
+  static void destroy(Thread* thread) {
+    guarantee(!data(thread)->_context_active, "Jam thread context must be inactive before destruction");
+    jam_vm_thread_destroy(data(thread)->_context);
+    data(thread)->~JamThreadLocalData();
+  }
+
+  static bool context_active(Thread* thread) {
+    return data(thread)->_context_active;
+  }
+
+  static void enter(Thread* thread) {
+    guarantee(thread == Thread::current_or_null(), "Jam context must be entered by its own thread");
+    jam_vm_thread_enter(data(thread)->_context);
+    data(thread)->_context_active = true;
+  }
+
+  static void leave(Thread* thread) {
+    guarantee(thread == Thread::current_or_null(), "Jam context must be left by its own thread");
+    jam_vm_thread_leave(data(thread)->_context);
+    data(thread)->_context_active = false;
+  }
+
+  static size_t ergo_tlab_size(Thread *thread) {
+    return data(thread)->_ergo_tlab_size;
+  }
+
+  static int64_t last_tlab_time(Thread *thread) {
+    return data(thread)->_last_tlab_time;
+  }
+
+  static void set_ergo_tlab_size(Thread *thread, size_t val) {
+    data(thread)->_ergo_tlab_size = val;
+  }
+
+  static void set_last_tlab_time(Thread *thread, int64_t time) {
+    data(thread)->_last_tlab_time = time;
+  }
+};
+
+#endif // SHARE_GC_JAM_JAMTHREADLOCALDATA_HPP
