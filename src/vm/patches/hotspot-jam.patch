+void JamHeap::object_iterate(ObjectClosure *cl) {
+  assert(SafepointSynchronize::is_at_safepoint(), "Must stop mutators");
+  guarantee(_track_starts, "Heap iteration requires diagnostic preparation");
+  for (int young = 0; young != 2; ++young) {
+    size_t count;
+    uint32_t const* bits = jam_vm_start_bits(_jam, young, &count);
+    for (size_t i = 0; i < count; ++i) {
+      uint32_t word = bits[i];
+      while (word != 0) {
+        unsigned bit = count_trailing_zeros(word);
+        uint32_t at = uint32_t(i * 32 + bit) | (young ? uint32_t(1) << 31 : 0);
+        cl->do_object(CompressedOops::decode(narrowOop(at)));
+        word &= word - 1;
+      }
+    }
+  }
+}
