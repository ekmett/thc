+// SPDX-License-Identifier: GPL-2.0-only
+#include "gc/jam/c1/jamBarrierSetC1.hpp"
+#include "gc/jam/jamBarrierSet.hpp"
+#include "gc/jam/jamHeap.hpp"
+#include "c1/c1_LIRGenerator.hpp"
+#include "c1/c1_LIRAssembler.hpp"
+#include "c1/c1_MacroAssembler.hpp"
+#include "c1/c1_CodeStubs.hpp"
+#include "asm/macroAssembler.inline.hpp"
+class JamPostBarrierStub : public CodeStub {
+  LIR_Opr _owner;
+  LIR_Opr _slot;
+public:
+  JamPostBarrierStub(LIR_Opr owner, LIR_Opr slot) : _owner(owner), _slot(slot) {}
+  void visit(LIR_OpVisitState* visitor) override {
+    visitor->do_slow_case();
+    visitor->do_input(_owner);
+    visitor->do_input(_slot);
+  }
+  void emit_code(LIR_Assembler* ce) override {
+    MacroAssembler* masm = ce->masm();
+    masm->bind(*entry());
+    masm->push_call_clobbered_registers();
+#ifdef AARCH64
+    masm->stp(_owner->as_register(), _slot->as_pointer_register(), Address(Pre(sp, -2 * wordSize)));
+    masm->ldp(c_rarg0, c_rarg1, Address(Post(sp, 2 * wordSize)));
+    masm->mov(c_rarg2, 1);
+#else
+    masm->push(_owner->as_register());
+    masm->push(_slot->as_pointer_register());
+    masm->pop(c_rarg1);
+    masm->pop(c_rarg0);
+    masm->movptr(c_rarg2, 1);
+#endif
+    masm->call_VM_leaf(CAST_FROM_FN_PTR(address, JamBarrierSet::record_narrow), c_rarg0, c_rarg1, c_rarg2);
+    masm->pop_call_clobbered_registers();
+#ifdef AARCH64
+    masm->b(*continuation());
+#else
+    masm->jmp(*continuation());
+#endif
+  }
+#ifndef PRODUCT
+  void print_name(outputStream* out) const override { out->print("JamPostBarrierStub"); }
+#endif
+};
+
+#ifdef ASSERT
+#define __ gen->lir(__FILE__, __LINE__)->
+#else
+#define __ gen->lir()->
+#endif
+LIR_Opr JamBarrierSetC1::resolve_address(LIRAccess& access, bool resolve_in_register) {
+  bool write = (access.decorators() & ACCESS_WRITE) != 0;
+  return BarrierSetC1::resolve_address(access, resolve_in_register || (write && access.is_oop()));
+}
+void JamBarrierSetC1::post_barrier(LIRAccess& access, LIR_Opr, LIR_Opr) {
+  if ((access.decorators() & IN_HEAP) == 0) return;
+  LIRGenerator* gen = access.gen();
+  LIR_Opr slot = access.resolved_addr();
+  if (slot->is_address()) {
+    LIR_Opr pointer = gen->new_pointer_register();
+    __ leal(slot, pointer);
+    slot = pointer;
+  }
+  LIR_Opr owner = access.base().opr();
+  if (!owner->is_register()) {
+    LIR_Opr reg = gen->new_register(T_OBJECT);
+    __ move(owner, reg);
+    owner = reg;
+  }
+  LIR_Opr last_before_young = gen->new_pointer_register();
+  __ move(LIR_OprFact::intptrConst((intptr_t)JamHeap::heap()->young_begin() - 1), last_before_young);
+  CodeStub* slow = new JamPostBarrierStub(owner, slot);
+  __ cmp(lir_cond_belowEqual, slot, last_before_young);
+  __ branch(lir_cond_belowEqual, slow);
+  __ branch_destination(slow->continuation());
+}
