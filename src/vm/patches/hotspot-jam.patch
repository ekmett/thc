+  }
+  size_t young_bytes = JamYoungSize == 0
+                    ? MAX2(align, align_down(max_byte_size / 4, align))
+                    : align_up(JamYoungSize, align);
+  if (young_bytes >= max_byte_size) {
+    vm_exit_during_initialization("JamYoungSize must leave space for old objects");
+  }
+  size_t old_bytes = max_byte_size - young_bytes;
+  // The generation bit denotes a 16 GiB virtual displacement, not physical capacity.
+  ReservedHeapSpace heap_rs = Universe::reserve_heap(jam_young_displacement + young_bytes, align);
+  size_t prefix = heap_rs.noaccess_prefix();
+  if (JamReserve > (size_t(1) << 34)) {
+    vm_exit_during_initialization("Jam reserve exceeds the 16 GiB arena limit");
+  }
+  size_t reserve = align_up(JamReserve, os::vm_page_size());
+  if (init_byte_size != max_byte_size || CompressedOops::base() == nullptr ||
+      CompressedOops::shift() != 3 || prefix == 0 ||
+      CompressedOops::base() != (address)heap_rs.compressed_oop_base() ||
+      prefix + old_bytes + reserve > jam_young_displacement ||
+      prefix + young_bytes + reserve > jam_young_displacement ||
+      reserve > prefix + MIN2(old_bytes, young_bytes)) {
+    log_error(gc)("Jam heap encoding: heap=[" PTR_FORMAT "," PTR_FORMAT
+      "), compressed base=" PTR_FORMAT ", reservation base=" PTR_FORMAT ", shift=%d",
+      p2i(heap_rs.base()), p2i(heap_rs.end()), p2i(CompressedOops::base()),
+      p2i(heap_rs.compressed_oop_base()), CompressedOops::shift());
+    log_error(gc)("Jam heap sizes: prefix=%zu, initial=%zu, maximum=%zu, reserve=%zu, HeapBaseMinAddress=" PTR_FORMAT,
+      prefix, init_byte_size, max_byte_size, reserve, (uintptr_t)HeapBaseMinAddress);
+    vm_exit_during_initialization("Jam requires fixed, nonzero-base shift-three generations below 16 GiB each including their guards and reserve");
+  }
+  // VirtualSpace records the reservation only. Jam owns and maps the backing.
+  _virtual_space.initialize(heap_rs, 0);
+  _jam = jam_vm_create(CompressedOops::base(), prefix, old_bytes, young_bytes,
+                       reserve, JamWorkers);
+  MemRegion old_region((HeapWord*)heap_rs.base(), old_bytes / HeapWordSize);
+  MemRegion young_region((HeapWord*)(heap_rs.base() + jam_young_displacement), young_bytes / HeapWordSize);
+
+  initialize_reserved_region(heap_rs);
+
+  _space = new ContiguousSpace();
+  _space->initialize(old_region, /* clear_space = */ false, /* mangle_space = */ false);
+  _space->set_top(_space->bottom());
+  _young_space = new ContiguousSpace();
+  _young_space->initialize(young_region, false, false);
+  _young_space->set_top(_young_space->bottom());
+  GCLocker::initialize();
+
+  // Precompute hot fields
+  _max_tlab_size = MIN3(CollectedHeap::max_tlab_size(), align_object_size(JamMaxTLABSize / HeapWordSize),
+                       young_bytes / HeapWordSize);
+  _step_counter_update = MIN2<size_t>(max_byte_size / 16, JamUpdateCountersStep);
+  _step_heap_print = (JamPrintHeapSteps == 0) ? SIZE_MAX : (max_byte_size / JamPrintHeapSteps);
+  _decay_time_ns = (int64_t) JamTLABDecayTime * NANOSECS_PER_MILLISEC;
+
+  // Enable monitoring
+  _monitoring_support = new JamMonitoringSupport(this);
+  _last_counter_update = 0;
+  _last_heap_print = 0;
+
+  // Verification can run before a diagnostic preparation boundary.
+  if (VerifyDuringStartup || VerifyBeforeGC || VerifyAfterGC || VerifyDuringGC || VerifyBeforeExit) {
+    guarantee(jam_vm_track_starts(_jam), "Unable to allocate Jam object-start metadata");
+    _track_starts = true;
+  }
+
+  // Install barrier set
+  JamBarrierSet* barriers = new JamBarrierSet();
+  BarrierSet::set_barrier_set(barriers);
+
+  // All done, print out the configuration
+  JamInitLogger::print();
+  log_info(gc)("Jam collector: %s, %u copy workers, serial VM scanner",
+               jam_vm_compactor(_jam), JamWorkers);
+  log_info(gc)("Jam generations: old=%zu, young=%zu usable bytes; virtual displacement=%zu",
+               old_bytes, young_bytes, jam_young_displacement);
+
+  return JNI_OK;
+}
