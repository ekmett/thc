+#include "opto/castnode.hpp"
+#include "gc/jam/jamHeap.hpp"
+Node* JamBarrierSetC2::store_at_resolved(C2Access& access, C2AccessValue& val) const {
+  Node* store = BarrierSetC2::store_at_resolved(access, val);
+  if (access.is_oop() && (access.decorators() & (IN_HEAP | ON_UNKNOWN_OOP_REF)) != 0) {
+    assert(access.is_parse_access(), "Reference stores require a parse access");
+    post_barrier(static_cast<C2ParseAccess&>(access).kit(), access.base(), access.addr().node(), val.node(), true);
+  }
+  return store;
+}
+void JamBarrierSetC2::post_barrier(GraphKit* kit, Node* obj, Node* adr, Node*, bool) const {
+  Node* young = kit->longcon((jlong)JamHeap::heap()->young_begin());
+  Node* slot = kit->gvn().transform(new CastP2XNode(kit->control(), adr));
+  Node* cmp = kit->gvn().transform(new CmpULNode(slot, young));
+  Node* below_young = kit->gvn().transform(new BoolNode(cmp, BoolTest::lt));
+  Node* memory = kit->reset_memory();
+  kit->set_all_memory(memory);
+  IfNode* branch = kit->create_and_map_if(kit->control(), below_young, PROB_UNLIKELY(0.9), COUNT_UNKNOWN);
+  Node* skip = kit->gvn().transform(new IfFalseNode(branch));
+  kit->set_control(kit->gvn().transform(new IfTrueNode(branch)));
+  const Type** fields = TypeTuple::fields(4);
+  fields[TypeFunc::Parms] = TypeInstPtr::BOTTOM;
+  fields[TypeFunc::Parms + 1] = TypeRawPtr::BOTTOM;
+  fields[TypeFunc::Parms + 2] = TypeLong::LONG;
+  fields[TypeFunc::Parms + 3] = Type::HALF;
+  const TypeFunc* type = TypeFunc::make(TypeTuple::make(TypeFunc::Parms + 4, fields), TypeTuple::make(TypeFunc::Parms, TypeTuple::fields(0)));
+  kit->make_runtime_call(GraphKit::RC_LEAF, type,
+      CAST_FROM_FN_PTR(address, JamBarrierSet::record_narrow), "jam_remember", TypePtr::BOTTOM,
+      obj, adr, kit->longcon(1), kit->top());
+  RegionNode* region = new RegionNode(3);
+  region->init_req(1, skip);
+  region->init_req(2, kit->control());
+  PhiNode* merged = new PhiNode(region, Type::MEMORY, TypePtr::BOTTOM);
+  merged->init_req(1, memory);
+  merged->init_req(2, kit->reset_memory());
+  kit->set_control(kit->gvn().transform(region));
+  kit->set_all_memory(kit->gvn().transform(merged));
+}
+
+void JamBarrierSetC2::clone_at_expansion(PhaseMacroExpand* phase, ArrayCopyNode* ac) const {
+  clone_in_runtime(phase, ac, CAST_FROM_FN_PTR(address, JamBarrierSet::clone), "jam_clone");
+}
+
+bool JamBarrierSetC2::is_gc_barrier_node(Node* node) const {
+  return node->is_CallLeaf() &&
+      node->as_CallLeaf()->entry_point() == CAST_FROM_FN_PTR(address, JamBarrierSet::record_narrow);
+}
+
+Node* JamBarrierSetC2::obj_allocate(PhaseMacroExpand* macro, Node* mem, Node* toobig_false,
+    Node* size_in_bytes, Node*& i_o, Node*& needgc_ctrl, Node*& fast_oop_ctrl,
+    Node*& fast_oop_rawmem, intx prefetch_lines) const {
+  Node* obj = BarrierSetC2::obj_allocate(macro, mem, toobig_false, size_in_bytes,
+      i_o, needgc_ctrl, fast_oop_ctrl, fast_oop_rawmem, prefetch_lines);
+  Node* guard = macro->makecon(TypeRawPtr::make((address)&JamHeap::_track_starts));
+  Node* enabled = macro->make_load(fast_oop_ctrl, fast_oop_rawmem, guard, 0, TypeInt::BOOL, T_BOOLEAN);
+  Node* test = macro->transform_later(new CmpINode(enabled, macro->intcon(0)));
+  Node* condition = macro->transform_later(new BoolNode(test, BoolTest::ne));
+  Node* branch = macro->transform_later(new IfNode(fast_oop_ctrl, condition, PROB_UNLIKELY_MAG(4), COUNT_UNKNOWN));
+  Node* yes = macro->transform_later(new IfTrueNode(branch->as_If()));
+  Node* no = macro->transform_later(new IfFalseNode(branch->as_If()));
+  const Type** fields = TypeTuple::fields(1);
+  fields[TypeFunc::Parms] = TypeRawPtr::BOTTOM;
+  const TypeFunc* type = TypeFunc::make(TypeTuple::make(TypeFunc::Parms + 1, fields),
+      TypeTuple::make(TypeFunc::Parms, TypeTuple::fields(0)));
+  Node* call = macro->make_leaf_call(yes, fast_oop_rawmem, type,
+      CAST_FROM_FN_PTR(address, JamHeap::record_start), "jam_record_start", TypeRawPtr::BOTTOM, obj);
+  macro->transform_later(call);
+  Node* region = new RegionNode(3);
+  region->init_req(1, no);
+  region->init_req(2, macro->transform_later(new ProjNode(call, TypeFunc::Control)));
+  macro->transform_later(region);
+  Node* memory = new PhiNode(region, Type::MEMORY, TypeRawPtr::BOTTOM);
+  memory->init_req(1, fast_oop_rawmem);
+  memory->init_req(2, macro->transform_later(new ProjNode(call, TypeFunc::Memory)));
+  fast_oop_ctrl = region;
+  fast_oop_rawmem = macro->transform_later(memory);
+  return obj;
+}
