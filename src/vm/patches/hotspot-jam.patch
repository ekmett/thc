+// SPDX-License-Identifier: GPL-2.0-only
+#include "gc/jam/c2/jamBarrierSetC2.hpp"
+#include "gc/jam/jamBarrierSet.hpp"
+#include "opto/graphKit.hpp"
+#include "opto/runtime.hpp"
