+// SPDX-License-Identifier: GPL-2.0-only
+#include "asm/macroAssembler.inline.hpp"
+#include "gc/jam/jamBarrierSet.hpp"
+#include "gc/jam/jamHeap.hpp"
+#include "gc/jam/jamBarrierSetAssembler.hpp"
+#define __ masm->
+void JamBarrierSetAssembler::oop_store_at(MacroAssembler* masm, DecoratorSet decorators, BasicType type,
+                                         Address dst, Register val, Register tmp1, Register tmp2, Register tmp3) {
+  if ((decorators & IN_HEAP) != 0) {
+    Label done;
+    if (tmp1 != noreg && tmp2 != noreg && tmp1 != tmp2 &&
+        tmp1 != val && tmp2 != val && !dst.uses(tmp1) && !dst.uses(tmp2)) {
+      __ lea(tmp1, dst);
+      __ movptr(tmp2, (intptr_t)JamHeap::heap()->young_begin());
+      __ cmpptr(tmp1, tmp2);
+      __ jcc(Assembler::aboveEqual, done);
+    }
+    // Register before the store: the leaf call cannot safepoint and never loads the slot.
+    __ push_call_clobbered_registers();
+    __ push(dst.base());
+    __ lea(tmp1, dst);
+    __ push(tmp1);
+    __ pop(c_rarg1);
+    __ pop(c_rarg0);
+    __ movptr(c_rarg2, 1);
+    __ call_VM_leaf(CAST_FROM_FN_PTR(address, JamBarrierSet::record_narrow), c_rarg0, c_rarg1, c_rarg2);
+    __ pop_call_clobbered_registers();
+    __ bind(done);
+  }
+  BarrierSetAssembler::store_at(masm, decorators, type, dst, val, tmp1, tmp2, tmp3);
+}
+void JamBarrierSetAssembler::gen_write_ref_array_post_barrier(MacroAssembler* masm, DecoratorSet,
+                                         Register start, Register count, Register tmp) {
+  Label done;
+  if (tmp != noreg && tmp != start && tmp != count) {
+    __ movptr(tmp, (intptr_t)JamHeap::heap()->young_begin());
+    __ cmpptr(start, tmp);
+    __ jcc(Assembler::aboveEqual, done);
+  }
+  __ push_call_clobbered_registers();
+  __ push(start);
+  __ push(count);
+  __ pop(c_rarg1);
+  __ pop(c_rarg0);
+  __ call_VM_leaf(CAST_FROM_FN_PTR(address, JamBarrierSet::record_array), c_rarg0, c_rarg1);
+  __ pop_call_clobbered_registers();
+  __ bind(done);
+}
+
+void JamBarrierSetAssembler::tlab_allocate(MacroAssembler* masm, Register obj,
+    Register var_size_in_bytes, int con_size_in_bytes, Register t1, Register t2, Label& slow_case) {
+  BarrierSetAssembler::tlab_allocate(masm, obj, var_size_in_bytes, con_size_in_bytes, t1, t2, slow_case);
+  Label done;
+  __ movptr(t1, (intptr_t)&JamHeap::_track_starts);
+  __ cmpb(Address(t1, 0), 0);
+  __ jcc(Assembler::equal, done);
+  __ push_call_clobbered_registers();
+  __ movptr(c_rarg0, obj);
+  __ call_VM_leaf(CAST_FROM_FN_PTR(address, JamHeap::record_start), c_rarg0);
+  __ pop_call_clobbered_registers();
+  __ bind(done);
+}
