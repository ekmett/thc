+#include "services/memoryManager.hpp"
+#include "jam_vm.h"
+
+class ReferenceProcessor;
+struct JamScanState;
+
+class JamHeap : public CollectedHeap {
+  friend class VMStructs;
+private:
+  JamMonitoringSupport* _monitoring_support;
+  MemoryPool* _pool;
+  GCMemoryManager _memory_manager;
+  ContiguousSpace* _space;
+  ContiguousSpace* _young_space;
+  size_t _minor_collections;
+  size_t _promotions;
+  size_t _major_collections;
+  VirtualSpace _virtual_space;
+  jam_vm* _jam;
+  ReferenceProcessor* _ref_processor;
+  JamScanState* _jam_scan_state;
+  size_t _max_tlab_size;
+  size_t _step_counter_update;
+  size_t _step_heap_print;
+  int64_t _decay_time_ns;
+  volatile size_t _last_counter_update;
+  volatile size_t _last_heap_print;
+
+public:
+  static JamHeap* heap();
+
+  JamHeap() :
+          _memory_manager("Jam Heap"),
+          _space(nullptr),
+          _young_space(nullptr),
+          _minor_collections(0),
+          _promotions(0),
+          _major_collections(0),
+          _jam(nullptr),
+          _ref_processor(nullptr),
+          _jam_scan_state(nullptr) {};
+
+  Name kind() const override {
+    return CollectedHeap::Jam;
+  }
+
+  const char* name() const override {
+    return "Jam";
+  }
+
+  jint initialize() override;
+  void post_initialize() override;
+  void initialize_serviceability() override;
+
+  GrowableArray<GCMemoryManager*> memory_managers() override;
+  GrowableArray<MemoryPool*> memory_pools() override;
+
+  size_t max_capacity() const override { return capacity(); }
+  size_t capacity()     const override { return _space->capacity() + _young_space->capacity(); }
+  size_t used()         const override { return _space->used() + _young_space->used(); }
+
+  bool is_in(const void* p) const override {
+    return _space->is_in(p) || _young_space->is_in(p);
+  }
+
+  bool is_in_young(const void* p) const { return _young_space->is_in(p); }
+  HeapWord* young_begin() const {
+    assert(_young_space->end() == reserved_region().end(), "Young space ends the reservation");
+    return _young_space->bottom();
+  }
+  // Fresh young TLAB chunks need no barrier; old chunks can acquire young oops.
+  bool requires_barriers(stackChunkOop obj) const override { return !is_in_young(obj); }
+
+  // Allocation
+  HeapWord* allocate_work(size_t size, bool young, bool verbose = true);
+  HeapWord* allocate_or_collect_work(size_t size, bool tlab = false, bool verbose = true);
+  HeapWord* mem_allocate(size_t size, bool* gc_overhead_limit_was_exceeded) override;
+  HeapWord* allocate_new_tlab(size_t min_size,
+                              size_t requested_size,
+                              size_t* actual_size) override;
+
+  // TLAB allocation
+  size_t tlab_capacity(Thread* thr)         const override { return _young_space->capacity(); }
+  size_t tlab_used(Thread* thr)             const override { return _young_space->used(); }
+  size_t max_tlab_size()                    const override { return _max_tlab_size; }
+  size_t unsafe_max_tlab_alloc(Thread* thr) const override;
+
+  void collect(GCCause::Cause cause) override;
+  void do_full_collection(bool clear_all_soft_refs) override;
+  void collect_generation(bool minor, bool promote, GCCause::Cause cause);
+  void do_collection(bool minor, bool promote, bool clear_all_soft_refs);
+  size_t collections(int kind) const;
+  jam_vm* jam() const { return _jam; }
+  ReferenceProcessor* ref_processor() const { return _ref_processor; }
+  void trace_external(uint32_t const* roots, size_t count);
+
+  // Heap walking support
+  void prepare_for_object_iteration() override;
+  void object_iterate(ObjectClosure* cl) override;
+  static bool _track_starts;
+  static void record_start(oopDesc* obj);
+
+  // Moving collection waits for JNI critical regions through GCLocker.
+  void pin_object(JavaThread* thread, oop obj) override;
+  void unpin_object(JavaThread* thread, oop obj) override;
+
+  // No support for block parsing.
+  HeapWord* block_start(const void* addr) const { return nullptr;  }
+  bool block_is_obj(const HeapWord* addr) const { return false; }
+
+  // No GC threads
+  void gc_threads_do(ThreadClosure* tc) const override {}
+
+  // No nmethod handling
+  void register_nmethod(nmethod* nm) override {}
+  void unregister_nmethod(nmethod* nm) override {}
+  void verify_nmethod(nmethod* nm) override {}
+
+  void prepare_for_verify() override;
+  void verify(VerifyOption option) override;
+
+  MemRegion reserved_region() const { return _reserved; }
+  bool is_in_reserved(const void* addr) const { return _reserved.contains(addr); }
+
+  // Support for loading objects from CDS archive into the heap
+  bool can_load_archived_objects() const override { return false; }
+  HeapWord* allocate_loaded_archive_space(size_t size) override;
+
+  void print_heap_on(outputStream* st) const override;
+  void print_gc_on(outputStream* st) const override {}
+  void print_tracing_info() const override;
+  bool print_location(outputStream* st, void* addr) const override;
+
+private:
+  void print_heap_info(size_t used) const;
+  void print_metaspace_info() const;
+  void trace_remembered_slots();
+
+};
+
+#endif // SHARE_GC_JAM_JAMHEAP_HPP
