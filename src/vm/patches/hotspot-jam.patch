+// HeapReserver owns one candidate at a time and releases unsuccessful probes
+// before trying another. Keep the original extent even after the compressed-oop
+// guard is trimmed from the ReservedHeapSpace exposed to the collector.
+static char* volatile jam_heap_placeholder_base = nullptr;
+static size_t jam_heap_placeholder_size = 0;
+
+char* os::win32::reserve_jam_heap(char* requested_address, size_t bytes, size_t alignment) {
+  assert(UseJamGC, "Jam reservation only");
+  assert(is_aligned(requested_address, alignment), "requested address alignment");
+  assert(is_aligned(bytes, os::vm_allocation_granularity()), "reservation size alignment");
+  guarantee(Atomic::load_acquire(&jam_heap_placeholder_base) == nullptr,
+            "release the previous Jam heap reservation before another probe");
+  if (SimulateFullAddressSpace) return nullptr;
+
+  // Like ZGC, resolve the Windows 10 placeholder API at runtime. Other collectors
+  // keep their existing OS admission and do not require a new import library.
+  typedef PVOID (WINAPI *VirtualAlloc2Fn)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER*, ULONG);
+  static HMODULE const kernelbase = GetModuleHandleW(L"KernelBase.dll");
+  static VirtualAlloc2Fn const allocate = kernelbase == nullptr ? nullptr :
+    reinterpret_cast<VirtualAlloc2Fn>(GetProcAddress(kernelbase, "VirtualAlloc2"));
+  if (allocate == nullptr) {
+    vm_exit_during_initialization("Jam requires Windows version 1803 or later for heap placeholders");
+  }
+
+  // Address requirements avoid the release/reacquire loop used for ordinary
+  // Windows reservations. An exact requested address must omit this parameter.
+  MEM_ADDRESS_REQUIREMENTS requirements = {};
+  requirements.Alignment = alignment;
+  MEM_EXTENDED_PARAMETER parameter = {};
+  parameter.Type = MemExtendedParameterAddressRequirements;
+  parameter.Pointer = &requirements;
+  char* const base = static_cast<char*>(allocate(GetCurrentProcess(), requested_address, bytes,
+    MEM_RESERVE | MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS,
+    requested_address == nullptr ? &parameter : nullptr, requested_address == nullptr ? 1 : 0));
+  if (base == nullptr) {
+    PreserveLastError ple;
+    log_debug(gc, heap, coops)("Jam placeholder reservation failed at " PTR_FORMAT
+                              " for %zu bytes (error %u)", p2i(requested_address), bytes, (uint)ple.v);
+    return nullptr;
+  }
+  assert(is_aligned(base, alignment), "VirtualAlloc2 must satisfy alignment");
+  assert(requested_address == nullptr || base == requested_address, "exact address required");
+  jam_heap_placeholder_size = bytes;
+  Atomic::release_store(&jam_heap_placeholder_base, base);
+  MemTracker::record_virtual_memory_reserve(base, bytes, CALLER_PC, mtJavaHeap);
+  log_debug(os, map)("Reserved Jam placeholders " RANGE_FORMAT, RANGE_FORMAT_ARGS(base, bytes));
+  return base;
+}
+
+static bool release_jam_heap(char* base, size_t bytes) {
+  if (bytes != jam_heap_placeholder_size) {
+    log_error(gc)("Release the complete Jam heap reservation, including its compressed-oop guard");
+    return false;
+  }
+  // After jam_vm_destroy, every published window has been restored to a
+  // placeholder. Never unmap a live alias or consume a neighboring reservation.
+  size_t remaining = bytes;
+  char* cursor = base;
+  unsigned regions = 0;
+  while (remaining != 0) {
+    MEMORY_BASIC_INFORMATION info = {};
+    if (!VirtualQuery(cursor, &info, sizeof(info)) || info.AllocationBase != cursor ||
+        info.State != MEM_RESERVE || info.RegionSize == 0 || info.RegionSize > remaining) {
+      log_error(gc)("Jam heap aliases must be unpublished before releasing their reservation");
+      return false;
+    }
+    cursor += info.RegionSize;
+    remaining -= info.RegionSize;
+    ++regions;
+  }
+  if (regions > 1 && !virtualFree(base, bytes, MEM_RELEASE | MEM_COALESCE_PLACEHOLDERS)) {
+    return false;
+  }
+  // Clear ownership before making the addresses available to another allocator.
+  // os::release_memory supplies NMT locking and records the release on success.
+  Atomic::release_store(&jam_heap_placeholder_base, (char*)nullptr);
+  if (!virtualFree(base, 0, MEM_RELEASE)) {
+    Atomic::release_store(&jam_heap_placeholder_base, base);
+    return false;
+  }
+  return true;
+}
