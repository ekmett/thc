+#define SHARE_GC_JAM_JAMBARRIERSET_HPP
+
+#include "gc/shared/modRefBarrierSet.inline.hpp"
+
+// Remember exact source slots; target headers supply tracing policy.
+class JamBarrierSet: public ModRefBarrierSet {
+  friend class VMStructs;
+
+public:
+  JamBarrierSet();
+  void print_on(outputStream* st) const override;
+
+  static void record(oop owner, void* slot, size_t count, bool compressed);
+  static void forget(address start, address end);
+  static void record_narrow(oopDesc* owner, void* slot, size_t count);
+  static void clone(oopDesc* src, oopDesc* dst, size_t words);
+  static void record_array(void* slot, size_t count);
+  void write_region(MemRegion mr) override;
+  void write_region(JavaThread*, MemRegion mr) override { write_region(mr); }
+  void write_ref_array(HeapWord* start, size_t count) { record_array(start, count); }
+
+  template <DecoratorSet decorators, typename T>
+  void write_ref_field_post(T* slot) { record(nullptr, slot, 1, sizeof(T) == sizeof(narrowOop)); }
+
+  virtual void on_thread_create(Thread* thread);
+  virtual void on_thread_destroy(Thread* thread);
+  virtual void on_thread_start(Thread* thread);
+  virtual void on_thread_attach(Thread* thread);
+  virtual void on_thread_detach(Thread* thread);
+
+  template <DecoratorSet decorators, typename BarrierSetT = JamBarrierSet>
+  class AccessBarrier: public ModRefBarrierSet::AccessBarrier<decorators, BarrierSetT> {
+    typedef BarrierSet::AccessBarrier<decorators, BarrierSetT> Raw;
+  public:
+    static void oop_store_in_heap_at(oop base, ptrdiff_t offset, oop value) {
+      auto* slot = AccessInternal::oop_field_addr<decorators>(base, offset);
+      Raw::oop_store(slot, value);
+      record(base, slot, 1, sizeof(*slot) == sizeof(narrowOop));
+    }
+    static oop oop_atomic_xchg_in_heap_at(oop base, ptrdiff_t offset, oop value) {
+      auto* slot = AccessInternal::oop_field_addr<decorators>(base, offset);
+      oop result = Raw::oop_atomic_xchg(slot, value);
+      record(base, slot, 1, sizeof(*slot) == sizeof(narrowOop));
+      return result;
+    }
+    static oop oop_atomic_cmpxchg_in_heap_at(oop base, ptrdiff_t offset, oop expected, oop value) {
+      auto* slot = AccessInternal::oop_field_addr<decorators>(base, offset);
+      oop result = Raw::oop_atomic_cmpxchg(slot, expected, value);
+      if (result == expected) record(base, slot, 1, sizeof(*slot) == sizeof(narrowOop));
+      return result;
+    }
+  };
+};
