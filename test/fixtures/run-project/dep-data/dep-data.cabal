name: dep-data
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
flag recent
  default: False
  manual: True
library
  exposed-modules: Answer
  hs-source-dirs: src
  build-depends: base >=4.22 && <4.23
  default-language: Haskell2010
  if flag(recent)
    cpp-options: -DPROJECT_RECENT
