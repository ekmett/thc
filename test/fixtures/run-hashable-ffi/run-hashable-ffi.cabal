cabal-version: 3.0
-- SPDX-FileCopyrightText: 2026 Edward Kmett
-- SPDX-License-Identifier: UPL-1.0 AND BSD-3-Clause
name: run-hashable-ffi
version: 0.1.0.0
build-type: Simple
license: UPL-1.0 AND BSD-3-Clause

library
  exposed-modules: HashableProbe
  hs-source-dirs: src
  build-depends: base >= 4.22 && < 4.23, hashable == 1.5.1.0,
                bytestring >= 0.12 && < 0.13, text >= 2.1 && < 2.2
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror

executable oracle
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base >= 4.22 && < 4.23, run-hashable-ffi
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror
