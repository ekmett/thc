cabal-version: 3.0
name: wcwidth-ffi
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Width
  hs-source-dirs: src
  build-depends: base
  default-language: Haskell2010
  ghc-options: -O1
  cc-options: -D_XOPEN_SOURCE=700

executable oracle
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base, wcwidth-ffi
  default-language: Haskell2010
  ghc-options: -O1
