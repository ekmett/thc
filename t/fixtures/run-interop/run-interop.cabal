cabal-version: 3.0
-- SPDX-FileCopyrightText: 2026 Edward Kmett
-- SPDX-License-Identifier: UPL-1.0 AND BSD-3-Clause
name: run-interop
version: 0.1.0.0
build-type: Simple
license: UPL-1.0 AND BSD-3-Clause

library
  exposed-modules: InteropApi
  hs-source-dirs: lib
  ghc-options: @component-options
  build-depends: base >= 4.22 && < 4.23, thc:interop
  default-language: Haskell2010

executable interop-app
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base >= 4.22 && < 4.23, run-interop, interop-support
  build-tool-depends: run-interop:generator
  default-language: Haskell2010

executable generator
  main-is: Main.hs
  hs-source-dirs: native
  build-depends: base >= 4.22 && < 4.23
  default-language: Haskell2010

executable ordinary
  main-is: Main.hs
  hs-source-dirs: native
  build-depends: base >= 4.22 && < 4.23
  default-language: Haskell2010
